# CareerCraft environment template
# Copy this file to .env and replace every placeholder with a local or deployment value.

MONGO_USERNAME=admin
MONGO_PASSWORD=replace-with-a-strong-password
MONGO_URI=mongodb://admin:replace-with-a-strong-password@mongodb:27017/careercraft?authSource=admin
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
LINKEDIN_CLIENT_ID=replace-with-linkedin-client-id
LINKEDIN_CLIENT_SECRET=replace-with-linkedin-client-secret
LINKEDIN_CALLBACK_URL=http://localhost:3000/auth/linkedin/callback
GEMINI_API_KEY=replace-with-gemini-api-key
