# ==============================================================================
# CareerCraft - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the variables for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Frontend Client URL (used for CORS and OAuth redirect resolution)
# Local development: http://localhost:5173
# Production: https://your-production-domain.com
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Database (MongoDB)
# ------------------------------------------------------------------------------
# Local MongoDB: mongodb://localhost:27017/careercraft
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/careercraft?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/careercraft

# Optional MongoDB credentials (used when running via docker-compose)
MONGO_USERNAME=admin
MONGO_PASSWORD=replace-with-a-strong-password

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# ------------------------------------------------------------------------------
# 64+ char random string for Express session cookies (Required)
SESSION_SECRET=replace-with-a-secure-random-session-secret

# Secret key used for signing JWT tokens for mobile & API access
JWT_SECRET=replace-with-a-secure-random-jwt-secret

# Comma-separated list of admin emails with access to admin routes
ADMIN_EMAILS=admin@careercraft.com

# ------------------------------------------------------------------------------
# AI & LLM Service (Google Gemini)
# ------------------------------------------------------------------------------
# Obtain your free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Google OAuth (Sign-in with Google)
# ------------------------------------------------------------------------------
# Setup credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_web_client_id_here
GOOGLE_CLIENT_SECRET=your_google_web_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Mobile App Client IDs (Optional - for React Native Google Sign-In SDK)
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# ------------------------------------------------------------------------------
# LinkedIn OAuth (Sign-in & Profile Connection)
# ------------------------------------------------------------------------------
# Setup app at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_CALLBACK_URL=http://localhost:3000/auth/linkedin/callback
